# DataLens Backend Environment Configuration

# Application
APP_NAME="DataLens API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# PostgreSQL Async Database Connection
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/datalens"

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Security & Secrets
SECRET_KEY="datalens_dev_secret_key_replace_with_strong_random_value_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration
STORAGE_ROOT="./storage_data"
MAX_UPLOAD_SIZE_MB=50

# AI Provider Configuration (Google Gemini & Local Ollama)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"
AI_ENABLED=true
AI_SEND_SAMPLE_VALUES=false

# Local Ollama Fallback (Optional)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:4b"

